# Public entrypoint
HTTP_PORT=80

# Reproducible image/build sources. Defaults use official registries.
# In regions where official sources are slow, replace these with mirrors supplied
# by your cloud provider. Do not add registry credentials to this file.
MYSQL_IMAGE=mysql:8.4
MONGODB_IMAGE=mongo:8.0
PYTHON_BASE_IMAGE=python:3.12-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
APT_MIRROR=
APT_SECURITY_MIRROR=
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmjs.org
DOCKER_APT_REPOSITORY_URL=https://download.docker.com/linux/ubuntu

# MySQL. Use long random values and URL-safe characters.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
ERP_DB_NAME=benefits_ops_db
ERP_DB_USER=erp_app
ERP_DB_PASSWORD=replace-with-a-long-random-app-password

# MongoDB
MONGO_ROOT_USER=mongo_root
MONGO_ROOT_PASSWORD=replace-with-a-long-random-root-password
MONGODB_DB_NAME=langchain_db
MONGODB_APP_USER=erp_agent
MONGODB_APP_PASSWORD=replace-with-a-long-random-app-password
MONGODB_CHECKPOINT_COLLECTION=checkpoints

# Initial ERP login. Created only when the username does not exist.
ERP_ADMIN_USERNAME=yyf
ERP_ADMIN_PASSWORD=replace-with-a-strong-login-password
ERP_ADMIN_DISPLAY_NAME=yyf
ERP_ADMIN_ROLE=admin
ERP_ADMIN_DEPARTMENT=信用卡运营部

# Main and summary model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Qwen fallback and web search
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen-plus
ALIBABA_SEARCH_MODEL=qwen-plus

# OpenSandbox remains on the Docker host in the first deployment phase.
# It must listen on a host address reachable from Docker containers.
OPENSANDBOX_SERVER_VERSION=0.2.2
OPEN_SANDBOX_DOMAIN=http://host.docker.internal:18080
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_IMAGE=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/code-interpreter:v1.0.2
SANDBOX_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# Browser authentication
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=card-benefits-operations-agent
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=erp_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# true: visitors enter directly with an isolated anonymous browser identity.
# false: visitors must log in with an ERP user account.
AUTH_DEMO_MODE=false
AUTH_DEMO_DISPLAY_NAME=演示用户
AUTH_DEMO_ROLE=demo
AUTH_DEMO_DEPARTMENT=公开演示
CORS_ALLOWED_ORIGINS=http://localhost

# Optional external visualization MCP endpoint.
# XiaoBenYang endpoints require this API key as the XBY-APIKEY HTTP header.
ANALYSIS_MCP_URL=
XBY_API_KEY=
