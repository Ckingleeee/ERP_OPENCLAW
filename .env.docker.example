# Public entrypoint
HTTP_PORT=80

# MySQL. Use long random values and URL-safe characters.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
ERP_DB_NAME=motorparts_db
ERP_DB_USER=erp_app
ERP_DB_PASSWORD=replace-with-a-long-random-app-password

# MongoDB
MONGO_ROOT_USER=mongo_root
MONGO_ROOT_PASSWORD=replace-with-a-long-random-root-password
MONGODB_DB_NAME=langchain_db
MONGODB_APP_USER=erp_agent
MONGODB_APP_PASSWORD=replace-with-a-long-random-app-password
MONGODB_CHECKPOINT_COLLECTION=checkpoints

# Initial ERP login. Created only when the username does not exist.
ERP_ADMIN_USERNAME=yyf
ERP_ADMIN_PASSWORD=replace-with-a-strong-login-password
ERP_ADMIN_DISPLAY_NAME=yyf
ERP_ADMIN_ROLE=admin
ERP_ADMIN_DEPARTMENT=采购部

# Main and summary model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Qwen fallback and web search
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen-plus
ALIBABA_SEARCH_MODEL=qwen-plus

# OpenSandbox remains on the Docker host in the first deployment phase.
# It must listen on a host address reachable from Docker containers.
OPEN_SANDBOX_DOMAIN=http://host.docker.internal:18080
OPEN_SANDBOX_API_KEY=

# Browser authentication
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=erp-procurement-agent
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=erp_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost

# Optional external visualization MCP endpoint.
ANALYSIS_MCP_URL=
