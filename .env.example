# Python ERP API
ERP_API_HOST=127.0.0.1
ERP_API_PORT=8080
ERP_API_BASE_URL=http://127.0.0.1:8080/api

# MySQL 8
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=3306
ERP_DB_USER=root
ERP_DB_PASSWORD=change-me
ERP_DB_NAME=motorparts_db
ERP_DB_CONNECT_TIMEOUT=5
ERP_DB_CHECK_ON_STARTUP=true

# Agent model services (required by the chat backend, not by the ERP API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Alibaba Cloud Model Studio / Qwen (OpenAI-compatible endpoint)
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen-plus
ALIBABA_SEARCH_MODEL=qwen-plus

# Agent Web login authentication
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=erp-procurement-agent
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=erp_session
# Set to true after HTTPS is enabled.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
